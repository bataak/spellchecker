{
  "name": "hunspell-mn",
  "private": true,
  "version": "1.113.0",
  "type": "module",
  "description": "Монгол үгийн алдаа шалгагч — hunspell-wasm + nspell, GitHub Pages",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "tsc --noEmit && eslint . --quiet && node --test \"tests/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.ts\"",
    "predev": "npm test",
    "dev": "vite",
    "prebuild": "npm test",
    "build": "vite build",
    "prepreview": "npm test",
    "preview": "vite build && vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hunspell-wasm": "file:vendor/hunspell-wasm",
    "jspdf": "^4.2.1",
    "katex": "^0.18.9",
    "nspell": "^2.1.5",
    "pdfjs-dist": "5.4.624",
    "svg2pdf.js": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  }
}
